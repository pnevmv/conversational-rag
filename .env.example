# Copy to .env and fill in. Never commit .env.

# Generator, query rewriter and graph extraction (Azure OpenAI, Responses API)
# API key of the Azure OpenAI / Foundry resource
AZURE_OPENAI_API_KEY=
# Base URL of the resource, ending in /openai/v1 (optional: the default endpoint of src/llm/client.py is used if empty)
AZURE_OPENAI_BASE_URL=
# Deployment name of gpt-5.4-nano (optional: the default of src/llm/client.py is used if empty)
LLM_MODEL=
# Timeout of one API call in seconds (optional, default 120)
LLM_TIMEOUT=
# Path of the per-call token usage log, or "off" (optional, default experiments/logs/llm_usage.jsonl)
LLM_USAGE_LOG=

# Knowledge graph (Neo4j 5 in Docker: docker compose up -d neo4j)
# Bolt address of the Neo4j server, e.g. bolt://localhost:7687
NEO4J_URI=
# Neo4j user name
NEO4J_USER=
# Neo4j password, at least 8 characters
NEO4J_PASSWORD=
# Neo4j database name (optional, the server default if empty)
NEO4J_DATABASE=

# LLM judge through the Hugging Face inference router (experiments/judge_answers.py, optional)
# Hugging Face access token
HF_TOKEN=
# Judge model id on the router
JUDGE_MODEL=
# Other OpenAI-compatible endpoint for the judge instead of the router (optional)
JUDGE_BASE_URL=
# API key for that endpoint (optional, HF_TOKEN is used if empty)
JUDGE_API_KEY=

# Second generator for the model comparison: gpt-5-nano (experiments/model_comparison.py, optional)
# Base URL of the Foundry endpoint, ending in /openai/v1
AZURE_FOUNDRY_ENDPOINT=
# API key of the Foundry endpoint
AZURE_FOUNDRY_KEY=
# Deployment name of gpt-5-nano
AZURE_FOUNDRY_DEPLOYMENT=

# Third generator for the model comparison: gpt-6-luna (experiments/model_comparison.py, optional)
# Base URL of the Foundry endpoint, ending in /openai/v1
AZURE_LUNA_ENDPOINT=
# API key of the Foundry endpoint
AZURE_LUNA_KEY=
# Deployment name of gpt-6-luna
AZURE_LUNA_DEPLOYMENT=
