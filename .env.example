# Azure OpenAI API Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://2026-foundry.services.ai.azure.com/openai/v1
LLM_MODEL=gpt-5.4-nano-smirnov

# Neo4j (local Docker: `docker compose up -d neo4j`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_min_8_chars

# LLM judge through the Hugging Face inference router (experiments/judge_answers.py)
HF_TOKEN=your_hugging_face_token_here
JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Second generator: gpt-5-nano on the Foundry endpoint (Responses API)
AZURE_FOUNDRY_ENDPOINT=https://2026-foundry.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_KEY=your_foundry_key_here
AZURE_FOUNDRY_DEPLOYMENT=gpt-5-nano-smirnov

# Third generator: gpt-6-luna on the Foundry endpoint (Responses API)
AZURE_LUNA_ENDPOINT=https://2026-foundry.services.ai.azure.com/openai/v1
AZURE_LUNA_KEY=your_foundry_key_here
AZURE_LUNA_DEPLOYMENT=gpt-6-luna-smirnov
